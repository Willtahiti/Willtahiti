# Copier en .env et remplir avec les valeurs du projet Supabase
# (dashboard Supabase > Project Settings > API, ou sortie de `supabase start` en local)
#
# Préfixe EXPO_PUBLIC_ requis par Expo pour exposer une variable au bundle
# client (voir https://docs.expo.dev/guides/environment-variables/).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
