# Copier en .env et remplir avec les valeurs du projet Supabase
# (dashboard Supabase > Project Settings > API, ou sortie de `supabase start` en local)
#
# Le préfixe exact des variables (EXPO_PUBLIC_, REACT_APP_, ...) dépendra du
# choix d'outillage React Native fait au moment du squelette mobile.

SUPABASE_URL=
SUPABASE_ANON_KEY=
